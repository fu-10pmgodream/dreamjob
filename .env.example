# ============================================================
# DreamJob - Environment Variables (PLACEHOLDER)
# Sao chép file này thành .env và điền thông tin thực của bạn
# ============================================================

# ---- Cloudinary Configuration ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- App Configuration (Nếu không lên production có thể bỏ qua phần này) ----
# Khi deploy lên external Tomcat, server.port không có tác dụng
# Port được cấu hình trong Tomcat's server.xml (default: 8080)
APP_SECRET_KEY=dreamjob_secret_key_change_in_production
